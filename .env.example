# Copy to .env and fill in real values. .env is git-ignored - never commit it.

# freelancehunt.com/my/api2 -> generate an API key
FREELANCEHUNT_API_TOKEN=

# Telegram: @BotFather -> /newbot gives the token
TELEGRAM_BOT_TOKEN=
# chat to notify (your own chat id, e.g. via @userinfobot)
TELEGRAM_CHAT_ID=

# SMTP for the email channel (enable in config/notifications.json -> channels.email)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
